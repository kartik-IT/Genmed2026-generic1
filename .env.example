# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional openFDA API key. The public NDC Directory works without one, but a
# key is recommended for regular use and increases rate-limit headroom.
OPENFDA_API_KEY=""

# Optional partner adapter configuration. The provider base URLs must expose
# GET /stock?pharmacyId=&drugId= and GET /prices?drugId= under the documented
# server adapter contracts; keys remain server-side.
PHARMACY_STOCK_PROVIDER_URL=""
PHARMACY_STOCK_PROVIDER_KEY=""
PRICING_PROVIDER_URL=""
PRICING_PROVIDER_KEY=""

# OIDC authentication. Use a HIPAA-capable provider before any prescription or
# profile data is persisted. Callback must exactly match the provider setting.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:3001/api/auth/callback"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

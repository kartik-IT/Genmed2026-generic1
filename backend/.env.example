# Backend Environment Variables

# Server configuration
NODE_ENV=development
PORT=3001

# Frontend URL (for CORS)
APP_URL=http://localhost:3000

# Gemini AI Configuration
GEMINI_API_KEY=
OPENFDA_API_KEY=

# Pharmacy Stock Provider (optional)
PHARMACY_STOCK_PROVIDER_URL=
PHARMACY_STOCK_PROVIDER_KEY=

# Pricing Provider (optional)
PRICING_PROVIDER_URL=
PRICING_PROVIDER_KEY=

# OpenID Connect Configuration (optional - required for authentication)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Web Push Notifications (optional - generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
